// Dibujo de la placa y de los componentes. Todas las funciones reciben `h`
// (React.createElement) para poder usarse sin JSX.

const LED_COLORS = {
  red: '#ef4444', green: '#22c55e', yellow: '#facc15', blue: '#3b82f6', white: '#f1f5f9', orange: '#fb923c',
};

const BAND = { 0: '#111827', 1: '#92400e', 2: '#dc2626', 3: '#f97316', 4: '#eab308', 5: '#16a34a' };
const RESISTOR_BANDS = {
  '220 Ω': [2, 2, 1], '330 Ω': [3, 3, 1], '1 kΩ': [1, 0, 2], '10 kΩ': [1, 0, 3],
};

export const DEFAULT_LABELS = {
  led: 'LED', resistor: '', button: 'Pulsador', buzzer: 'Buzzer', pot: 'Potenciómetro',
  ldr: 'Fotorresistencia', tmp36: 'Sensor TMP36', display: 'Display de 7 segmentos', water: 'Sensor de nivel de agua',
};

function burstPoints(cx, cy, rOut, rIn, n) {
  const pts = [];
  for (let i = 0; i < n * 2; i++) {
    const r = i % 2 === 0 ? rOut : rIn;
    const a = (Math.PI * i) / n - Math.PI / 2;
    pts.push(`${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`);
  }
  return pts.join(' ');
}

const leg = (h, x1, y1, x2, y2, key) => h('line', { key, x1, y1, x2, y2, stroke: '#94a3b8', strokeWidth: 2.5, strokeLinecap: 'round' });

// ---------- Arduino UNO ----------
export function drawBoard(h, pins, { short = false } = {}) {
  const els = [];
  els.push(h('rect', { key: 'usb', x: 6, y: 22, width: 58, height: 42, rx: 3, fill: '#aab4c0', stroke: '#6b7785', strokeWidth: 2 }));
  els.push(h('rect', { key: 'jack', x: 6, y: 70, width: 46, height: 22, rx: 3, fill: '#1f2937' }));
  els.push(h('rect', { key: 'pcb', x: 20, y: 10, width: 720, height: 88, rx: 10, fill: '#0e7c86', stroke: '#0a5c64', strokeWidth: 3 }));
  els.push(h('rect', { key: 'usb2', x: 6, y: 22, width: 58, height: 42, rx: 3, fill: '#aab4c0', stroke: '#6b7785', strokeWidth: 2 }));
  els.push(h('circle', { key: 'reset', cx: 100, cy: 36, r: 9, fill: '#dc2626', stroke: '#7f1d1d', strokeWidth: 2 }));
  els.push(h('rect', { key: 'chip', x: 250, y: 28, width: 120, height: 36, rx: 3, fill: '#111827' }));
  els.push(h('text', { key: 'chiptxt', x: 310, y: 51, fill: '#6b7280', fontSize: 10, textAnchor: 'middle', fontFamily: 'monospace' }, 'ATmega328P'));
  els.push(h('text', { key: 'name', x: 560, y: 52, fill: '#d1fae5', fontSize: 24, fontWeight: 800, textAnchor: 'middle', fontFamily: 'Arial, sans-serif' }, 'ARDUINO UNO'));
  els.push(h('text', { key: 'inf', x: 440, y: 56, fill: '#d1fae5', fontSize: 30, textAnchor: 'middle' }, '∞'));
  els.push(h('rect', { key: 'hdr1', x: 32, y: 100, width: 290, height: 16, rx: 2, fill: '#111827' }));
  els.push(h('rect', { key: 'hdr2', x: 380, y: 100, width: 360, height: 16, rx: 2, fill: '#111827' }));
  els.push(h('text', { key: 'g1', x: 177, y: 72, fill: '#a7f3d0', fontSize: 9.5, fontWeight: 700, textAnchor: 'middle' }, 'ENERGÍA y ENTRADAS ANALÓGICAS'));
  els.push(h('text', { key: 'g2', x: 560, y: 72, fill: '#a7f3d0', fontSize: 9.5, fontWeight: 700, textAnchor: 'middle' }, 'PINES DIGITALES  (~ = PWM)'));
  pins.forEach((p) => {
    const color = p.kind === 'gnd' ? '#e5e7eb' : p.kind === '5v' ? '#fecaca' : '#ffffff';
    els.push(h('text', { key: 'l' + p.id, x: p.x, y: 90, fill: color, fontSize: p.label.length > 2 ? 9 : 11, fontWeight: 700, textAnchor: 'middle' }, p.label));
  });
  if (short) {
    els.push(h('rect', { key: 'sh1', x: 20, y: 10, width: 720, height: 88, rx: 10, fill: '#ef4444', opacity: 0.35 }));
    els.push(h('text', { key: 'sh2', x: 380, y: 66, fontSize: 30, fontWeight: 800, fill: '#fff', textAnchor: 'middle' }, '💥 ¡CORTOCIRCUITO!'));
  }
  return els;
}

// ---------- componentes ----------
const bodies = {
  led(h, { color = 'red' }, { lit }) {
    const c = LED_COLORS[color] || LED_COLORS.red;
    const els = [];
    if (lit) {
      els.push(h('circle', { key: 'glow2', cx: 0, cy: 14, r: 44, fill: c, opacity: 0.22 }));
      els.push(h('circle', { key: 'glow1', cx: 0, cy: 14, r: 30, fill: c, opacity: 0.35 }));
    }
    els.push(leg(h, -8, -40, -8, 2, 'la'));
    els.push(leg(h, 8, -34, 8, 2, 'lk'));
    els.push(h('path', { key: 'body', d: 'M-13 2 L-13 14 A13 13 0 0 0 13 14 L13 2 Z', fill: c, opacity: lit ? 1 : 0.7, stroke: '#7f1d1d', strokeWidth: 1.5, strokeOpacity: 0.4 }));
    els.push(h('rect', { key: 'rim', x: -15, y: 0, width: 30, height: 4, rx: 1, fill: c, opacity: lit ? 1 : 0.7 }));
    els.push(h('text', { key: 'plus', x: -19, y: -24, fill: '#b91c1c', fontSize: 12, fontWeight: 800, textAnchor: 'middle' }, '+'));
    els.push(h('text', { key: 'minus', x: 19, y: -20, fill: '#1e293b', fontSize: 12, fontWeight: 800, textAnchor: 'middle' }, '−'));
    return els;
  },
  resistor(h, { value = '220 Ω' }) {
    const bands = RESISTOR_BANDS[value] || [2, 2, 1];
    return [
      leg(h, -22, -30, -22, 6, 'l1'),
      leg(h, 22, -30, 22, 6, 'l2'),
      h('rect', { key: 'b', x: -24, y: 0, width: 48, height: 14, rx: 7, fill: '#e8d3a8', stroke: '#b89b6a', strokeWidth: 1.5 }),
      ...bands.map((c, i) => h('rect', { key: 'band' + i, x: -14 + i * 8, y: 0.5, width: 4, height: 13, fill: BAND[c] })),
      h('rect', { key: 'tol', x: 14, y: 0.5, width: 4, height: 13, fill: '#d4af37' }),
    ];
  },
  button(h) {
    return [
      leg(h, -12, -34, -12, -4, 'l1'),
      leg(h, 12, -34, 12, -4, 'l2'),
      h('rect', { key: 'base', x: -22, y: -4, width: 44, height: 36, rx: 5, fill: '#475569', stroke: '#1e293b', strokeWidth: 2 }),
      h('circle', { key: 'cap0', cx: 0, cy: 14, r: 13, fill: '#1e293b' }),
      h('circle', { key: 'cap', cx: 0, cy: 14, r: 10, fill: '#e2e8f0', stroke: '#94a3b8', strokeWidth: 2 }),
    ];
  },
  buzzer(h, _p, { lit }) {
    const els = [
      leg(h, -8, -36, -8, -6, 'lp'),
      leg(h, 8, -32, 8, -6, 'ln'),
      h('circle', { key: 'body', cx: 0, cy: 16, r: 24, fill: '#111827', stroke: '#374151', strokeWidth: 3 }),
      h('circle', { key: 'hole', cx: 0, cy: 16, r: 6, fill: '#374151' }),
      h('text', { key: 'plus', x: -14, y: 4, fill: '#e5e7eb', fontSize: 13, fontWeight: 800, textAnchor: 'middle' }, '+'),
    ];
    if (lit) {
      [30, 38, 46].forEach((r, i) => els.push(h('path', { key: 'w' + i, d: `M ${r} 6 A ${r} ${r} 0 0 1 ${r} 26`, fill: 'none', stroke: '#f59e0b', strokeWidth: 3, strokeLinecap: 'round', opacity: 1 - i * 0.25 })));
    }
    return els;
  },
  pot(h) {
    return [
      leg(h, -16, -38, -16, -6, 'l1'),
      leg(h, 0, -38, 0, -6, 'l2'),
      leg(h, 16, -38, 16, -6, 'l3'),
      h('rect', { key: 'body', x: -28, y: -6, width: 56, height: 46, rx: 8, fill: '#2563eb', stroke: '#1e3a8a', strokeWidth: 2 }),
      h('circle', { key: 'knob', cx: 0, cy: 17, r: 15, fill: '#e2e8f0', stroke: '#94a3b8', strokeWidth: 2 }),
      h('line', { key: 'mark', x1: 0, y1: 17, x2: 0, y2: 5, stroke: '#334155', strokeWidth: 3, strokeLinecap: 'round' }),
      h('text', { key: 't1', x: -16, y: -10, fill: '#475569', fontSize: 9, textAnchor: 'middle' }, '1'),
      h('text', { key: 't2', x: 16, y: -10, fill: '#475569', fontSize: 9, textAnchor: 'middle' }, '2'),
      h('text', { key: 'tw', x: 0, y: -10, fill: '#475569', fontSize: 9, textAnchor: 'middle' }, 'C'),
    ];
  },
  ldr(h) {
    return [
      leg(h, -8, -36, -8, -6, 'l1'),
      leg(h, 8, -36, 8, -6, 'l2'),
      h('circle', { key: 'body', cx: 0, cy: 14, r: 21, fill: '#d6a35c', stroke: '#8a5a1d', strokeWidth: 2 }),
      h('path', { key: 'zig', d: 'M-12 7 L-6 21 L0 7 L6 21 L12 7', fill: 'none', stroke: '#5b3a0e', strokeWidth: 2.5, strokeLinejoin: 'round' }),
    ];
  },
  tmp36(h) {
    return [
      leg(h, -16, -38, -16, -4, 'l1'),
      leg(h, 0, -38, 0, -4, 'l2'),
      leg(h, 16, -38, 16, -4, 'l3'),
      h('path', { key: 'body', d: 'M-22 -4 L22 -4 L22 20 A22 22 0 0 1 -22 20 Z', fill: '#1f2937', stroke: '#475569', strokeWidth: 2 }),
      h('text', { key: 'n', x: 0, y: 14, fill: '#e5e7eb', fontSize: 10, fontWeight: 700, textAnchor: 'middle' }, 'TMP36'),
      h('text', { key: 't1', x: -16, y: -9, fill: '#475569', fontSize: 7, textAnchor: 'middle' }, '5V'),
      h('text', { key: 't2', x: 0, y: -9, fill: '#475569', fontSize: 7, textAnchor: 'middle' }, 'OUT'),
      h('text', { key: 't3', x: 16, y: -9, fill: '#475569', fontSize: 7, textAnchor: 'middle' }, 'GND'),
    ];
  },
  display(h, { show = [] }, { lit }) {
    const on = (s) => lit && show.includes(s);
    const seg = (key, x1, y1, x2, y2) => h('line', {
      key, x1, y1, x2, y2, strokeWidth: 9, strokeLinecap: 'round',
      stroke: on(key) ? '#ef4444' : '#374151', opacity: on(key) ? 1 : 0.9,
    });
    const letters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'COM'];
    return [
      ...letters.map((l, i) => leg(h, -56 + i * 16, -66, -56 + i * 16, -42, 'leg' + i)),
      h('rect', { key: 'body', x: -66, y: -42, width: 132, height: 116, rx: 7, fill: '#111827', stroke: '#475569', strokeWidth: 2 }),
      ...letters.map((l, i) => h('text', { key: 'let' + i, x: -56 + i * 16, y: -30, fill: '#9ca3af', fontSize: l === 'COM' ? 6.5 : 10, fontWeight: 700, textAnchor: 'middle' }, l)),
      h('rect', { key: 'bezel', x: -36, y: -20, width: 72, height: 90, rx: 4, fill: '#1f2937' }),
      seg('a', -18, -8, 18, -8),
      seg('b', 25, -2, 25, 20),
      seg('c', 25, 32, 25, 54),
      seg('d', -18, 62, 18, 62),
      seg('e', -25, 32, -25, 54),
      seg('f', -25, -2, -25, 20),
      seg('g', -18, 27, 18, 27),
    ];
  },
  water(h) {
    const traces = [];
    for (let i = 0; i < 6; i++) {
      traces.push(h('line', { key: 'tr' + i, x1: -17, y1: 22 + i * 7, x2: 17, y2: 22 + i * 7, stroke: i % 2 ? '#bbf7d0' : '#d1fae5', strokeWidth: 3, strokeLinecap: 'round' }));
    }
    return [
      leg(h, -16, -38, -16, -6, 'l1'),
      leg(h, 0, -38, 0, -6, 'l2'),
      leg(h, 16, -38, 16, -6, 'l3'),
      h('rect', { key: 'body', x: -26, y: -6, width: 52, height: 78, rx: 4, fill: '#15803d', stroke: '#14532d', strokeWidth: 2 }),
      h('text', { key: 'p', x: -16, y: 8, fill: '#ecfdf5', fontSize: 11, fontWeight: 800, textAnchor: 'middle' }, '+'),
      h('text', { key: 'm', x: 0, y: 8, fill: '#ecfdf5', fontSize: 11, fontWeight: 800, textAnchor: 'middle' }, '−'),
      h('text', { key: 's', x: 16, y: 8, fill: '#ecfdf5', fontSize: 10, fontWeight: 800, textAnchor: 'middle' }, 'S'),
      ...traces,
    ];
  },
};

const LABEL_Y = { led: 52, resistor: 34, button: 48, buzzer: 56, pot: 58, ldr: 52, tmp36: 52, display: 94, water: 90 };
const BURN_Y = { led: 14, resistor: 8, button: 14, buzzer: 16, pot: 17, ldr: 14, tmp36: 10, display: 16, water: 34 };

export function drawPart(h, part, { lit = false, burned = false } = {}) {
  const body = bodies[part.type](h, part, { lit });
  const label = part.label ?? (part.type === 'resistor' ? part.value || '220 Ω' : DEFAULT_LABELS[part.type]);
  const by = BURN_Y[part.type];

  const els = [h('g', { key: 'body', opacity: burned ? 0.45 : 1 }, body)];

  if (label) {
    els.push(h('text', { key: 'label', x: 0, y: LABEL_Y[part.type], fill: '#1e293b', fontSize: 12, fontWeight: 700, textAnchor: 'middle' }, label));
  }

  if (burned) {
    els.push(h('circle', { key: 'burn-bg', cx: 0, cy: by, r: 40, fill: '#ef4444', opacity: 0.28 }));
    [-14, 0, 14].forEach((dx, i) => {
      els.push(h('circle', { key: 'smoke' + i, cx: dx, cy: by - 20, r: 7 + i, fill: '#475569', opacity: 0.5 },
        h('animate', { attributeName: 'cy', from: by - 14, to: by - 62, dur: `${1.4 + i * 0.3}s`, repeatCount: 'indefinite' }),
        h('animate', { attributeName: 'opacity', from: 0.6, to: 0, dur: `${1.4 + i * 0.3}s`, repeatCount: 'indefinite' })));
    });
    els.push(h('polygon', { key: 'boom', points: burstPoints(0, by, 30, 15, 12), fill: '#f97316', stroke: '#facc15', strokeWidth: 3 }));
    els.push(h('polygon', { key: 'boom2', points: burstPoints(0, by, 18, 9, 10), fill: '#fde047' }));
    els.push(h('text', { key: 'burnt', x: 0, y: LABEL_Y[part.type] + 15, fontSize: 12, fontWeight: 800, fill: '#b91c1c', textAnchor: 'middle' }, '¡Se quemó!'));
  }
  return els;
}
